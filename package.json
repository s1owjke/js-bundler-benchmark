{
  "name": "js-bundler-benchmark",
  "version": "0.1.0",
  "author": "s1owjke",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s1owjke/js-bundler-benchmark.git"
  },
  "scripts": {
    "build:bun": "BUN_ENV=production bun run ./scripts/build-bun.ts",
    "build:esbuild": "ts-node ./scripts/build-esbuild.ts",
    "build:parcel": "ts-node ./scripts/build-parcel.ts",
    "build:rollup": "ts-node ./scripts/build-rollup.ts",
    "build:rspack": "ts-node ./scripts/build-rspack.ts",
    "build:vite": "ts-node ./scripts/build-vite.ts",
    "build:webpack": "ts-node ./scripts/build-webpack.ts",
    "typecheck": "tsc --noEmit",
    "prettier:write": "prettier --write ./scripts/*.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@parcel/config-default": "^2.15.4",
    "@parcel/core": "^2.15.4",
    "@parcel/optimizer-terser": "^2.15.4",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^26.0.3",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^0.4.4",
    "@rspack/core": "^0.7.5",
    "@types/bun": "^1.2.22",
    "@types/fs-extra": "^11.0.4",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-loader": "^9.2.1",
    "bun": "^1.2.22",
    "esbuild": "^0.25.9",
    "esbuild-loader": "^4.3.0",
    "fs-extra": "^11.3.1",
    "prettier": "3.6.2",
    "rollup": "^4.50.2",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-swc3": "^0.12.1",
    "swc-loader": "^0.2.6",
    "terser-webpack-plugin": "^5.3.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^5.4.20",
    "webpack": "^5.101.3"
  }
}
